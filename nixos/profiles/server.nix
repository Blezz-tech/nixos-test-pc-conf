# Профиль сервера: без графики, без звука, без домашних приложений.
# Подключается хостам с role = "server" (см. hosts.nix).
#
# Пока это заготовка: машины нет, запись в hosts.nix выключена (enabled = false).
# Здесь только то, что точно нужно любой серверной машине.
{ ... }:
{
  # Единственный способ попасть на машину без монитора.
  services.openssh = {
    enable = true;
    settings.PermitRootLogin = "no";
  };

  # Вместо swap-файла: серверу не нужен лишний износ диска.
  zramSwap.enable = true;

  # Автообновление не включаем: сначала руками, потом решим.
  system.autoUpgrade.enable = false;
}
