# Домашние программы, которые нужны только на ноутбуке.
#
# Каталог home/hosts/<имя>/ подключается, если он существует (см. home/default.nix);
# у сервера home-manager нет вообще, у десктопа этот каталог просто не создан.
{ libx, ... }:
{
  imports = libx.allModules ./.;

  # Пример: батареечный индикатор вместо того, что стоит на десктопе.
  # home.packages = [ pkgs.battery-notify ];
}
